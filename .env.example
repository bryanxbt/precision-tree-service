# Copy to .env.local for local testing. For production, set the same
# names as GitHub repo Variables (Settings → Secrets and variables → Actions → Variables).

# --- Lead capture (configure ONE) ---
# Formspree: create form at https://formspree.io → use the form id
NEXT_PUBLIC_FORMSPREE_ID=

# OR Web3Forms: https://web3forms.com (free, email delivery)
NEXT_PUBLIC_WEB3FORMS_ACCESS_KEY=

# OR FormSubmit (default in code is qbstrees@gmail.com if unset)
# Confirm the inbox once via the activation email after first submit
NEXT_PUBLIC_FORMSUBMIT_EMAIL=qbstrees@gmail.com

# --- Analytics (optional) ---
# Google Analytics 4 measurement ID, e.g. G-XXXXXXXXXX
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Meta (Facebook) Pixel ID for ads
NEXT_PUBLIC_META_PIXEL_ID=
